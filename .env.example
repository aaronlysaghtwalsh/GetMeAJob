# Copy to .env to set server defaults. Everything here is optional.

# Where the server listens. 127.0.0.1 keeps it private to this computer.
PORT=3000
HOST=127.0.0.1

# Database, encrypted documents and the encryption key live here. Back this folder up.
DATA_DIR=./data

# Optional server-wide AI keys. A key saved in Settings > AI provider takes precedence.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=        # for OpenAI-compatible providers (OpenRouter, Ollama, LM Studio...)

# first-user (default): only the first account can sign up. open: anyone. closed: nobody.
SIGNUP_MODE=first-user

# 64 hex characters. If unset, a key is generated once in DATA_DIR/secret.key.
# APP_SECRET=

# Set to false to disable importing job postings from links.
ALLOW_OUTBOUND_FETCH=true

# Only needed when serving over HTTPS behind a proxy.
# SECURE_COOKIES=true
